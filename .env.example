# Environment template — placeholders and defaults only.
# Copy to .env.local, fill local values, and keep real secrets out of Git.
# Production/Preview values are configured separately in Vercel.

# Application URLs and environment
# Local dev worktree: pnpm exec next dev --port 3022.
# Vercel uses its own environment values; do not import this entire file.
PREEVAL_ENV=local
PREEVAL_ORIGIN=http://localhost:3021
PAYMENT_SITE_URL=https://www.americantranslationservice.com

# Supabase and staff authentication
# Server-only authentication configuration. Keep employee migration/cutover disabled until explicitly scheduled.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STAFF_AUTH_DATABASE_URL=
STAFF_LEGACY_MIGRATION_ENABLED=false
STAFF_AUTH_CUTOVER_ENABLED=false

# CRM business records
# The live CRM connection is separate from isolated customer test applications.
CRM_DATA_SOURCE=preview
CRM_DATABASE_URL=

# Isolated application database and test recipients
# Use the configured restricted cloud-preview role, or the optional local database.
# Hosted dev Preview requires PREEVAL_ENV=preview, cloud-preview mode and the exact branch origin.
PREEVAL_DATABASE_MODE=local
PREEVAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
PREEVAL_ADMIN_EMAIL=tech@meiyugroup.org
PREEVAL_TEST_EMAIL=tech@meiyugroup.org

# AI analysis
# Direct PDF/image analysis; the API key stays server-only.
PREEVAL_AI_ENABLED=false
OPENAI_API_KEY=
PREEVAL_OPENAI_MODEL=gpt-6.1-sol

# Email delivery
# Enable only after checking recipients. Cloud test sends require an application ID.
# EMAIL_ASSET_ORIGIN is the public HTTPS asset host, independent of localhost.
PREEVAL_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_DEFAULT_FROM_ADDRESS=info@americantranslationservice.com
RESEND_DEFAULT_FROM_NAME=AET
EMAIL_ASSET_ORIGIN=https://www.americantranslationservice.com

# Stripe payments
# Use test mode locally. Live mode requires the customer-facing deployment and HTTPS PAYMENT_SITE_URL.
# Original account: California/Miami. BOS account: Boston/NYC. No cross-account fallback.
# Publishable keys are currently unused by hosted Checkout.
STRIPE_PAYMENT_MODE=test
PREEVAL_STRIPE_TEST_ENABLED=false
STRIPE_TEST_SITE_URL=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY_BOS=
STRIPE_TEST_PUBLISHABLE_KEY_BOS=
STRIPE_LIVE_SECRET_KEY_BOS=
STRIPE_LIVE_PUBLISHABLE_KEY_BOS=

# PayPal office recipients
# Office-specific payment recipients.
PAYPAL_BUSINESS_MIAMI=
PAYPAL_BUSINESS_BOSTON=
PAYPAL_BUSINESS_CALIFORNIA=
PAYPAL_BUSINESS_NYC=

# Dropbox document integration and legacy lookup
# Reuse existing office accounts. Legacy lookup uses the existing anon key, not service-role credentials.
DROPBOX_DOCUMENTS_ENABLED=false
PREEVAL_DROPBOX_ROOT="/Team Files/WebsitesDev/AET-PreEvaluation-Test"
AET_APPLICATIONS_SUPABASE_URL=
AET_APPLICATIONS_SUPABASE_ANON_KEY=

# Dropbox original office account
# Server-only OAuth application credentials and namespace.
DROPBOX_AET_App_KEY=
DROPBOX_AET_App_SECRET=
DROPBOX_AET_App_REFRESH_TOKEN=
DROPBOX_AET_App_NAMESPACE_ID=

# Dropbox East office account
# Server-only OAuth application credentials and namespace.
DROPBOX_AET_App_East_KEY=
DROPBOX_AET_App_East_SECRET=
DROPBOX_AET_App_East_REFRESH_TOKEN=
DROPBOX_AET_App_East_NAMESPACE_ID=

# Scheduled tasks and formal payment expiry
# CRON_SECRET is shared by the project Cron endpoints. Keep expiry disabled locally.
# Vercel Production: copy the two secrets and set STATUS_EXPIRY_ENABLED=true.
# The expiry database account is restricted; do not replace it with CRM/admin credentials.
CRON_SECRET=
PREEVAL_AI_DAILY_RECOVERY_ENABLED=false
STATUS_EXPIRY_ENABLED=false
STATUS_EXPIRY_DATABASE_URL=
