# Environment template — placeholders and safe defaults only.
# Copy to .env.local and fill only the services you use.
# See README.md: Environment configuration for required versus optional settings.
# Only the six shared-name aliases listed in README remain readable; new names win, even when empty.
# Vercel values are managed separately; do not import the entire local file.

# 01. Shared application pilot — required for intake/workflow database access
# APP_/APPLICATION_ settings are shared by formal intake, pre-evaluation and staff workflows.
# APP_ENV: local for localhost; preview only for the approved Vercel dev branch.
# Origin: dev worktree uses port 3022; main worktree uses 3021.
# Database mode: local (optional local database) or cloud-preview (restricted cloud role).
# These values do not enable Production application cutover.
APP_ENV=local
APP_ORIGIN=http://localhost:3022
APPLICATION_DATABASE_MODE=local
APPLICATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# 02. Pilot test recipient — required by configuration()
# APPLICATION_TEST_EMAIL controls pre-evaluation/legacy workflow recipients and pre-evaluation test Checkout.
# New formal intake uses its own fixed pilot recipient; this is not a site-wide recipient override.
# Used by pilot workflows even when optional email dispatch is disabled.
APPLICATION_TEST_EMAIL=tech@meiyugroup.org

# 03. Staff authentication — required for staff sign-in, not public marketing pages
# Keep migration/cutover false unless the corresponding rollout is authorized.
# SUPABASE_SERVICE_ROLE_KEY is for administrative provisioning, not ordinary native-admin sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=
STAFF_AUTH_DATABASE_URL=
STAFF_LEGACY_MIGRATION_ENABLED=false
STAFF_AUTH_CUTOVER_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=

# 04. CRM business records — separate from isolated application data
# CRM_DATA_SOURCE=live uses shared production business records; preview uses the preview source.
CRM_DATA_SOURCE=preview
CRM_DATABASE_URL=

# 05. Optional AI analysis — enable only when using automated pre-evaluation
# PREEVAL_AI_ENABLED defaults to false; OPENAI_API_KEY is needed when enabled.
# PREEVAL_OPENAI_MODEL is an optional override; the code currently defaults to gpt-6.1-sol.
# Direct API analysis needs neither a local Codex binary nor Poppler.
PREEVAL_AI_ENABLED=false
OPENAI_API_KEY=
PREEVAL_OPENAI_MODEL=gpt-6.1-sol

# 06. Optional email delivery — provider credentials required when sending
# PREEVAL_EMAIL_ENABLED opts pre-evaluation into cloud-preview mail with application-scoped dispatch.
# It does not control the newer formal-intake confirmation sender.
# It is not a global mail kill switch: the older local-database dispatcher bypasses it.
# EMAIL_ASSET_ORIGIN is a public HTTPS asset host, independent of localhost.
PREEVAL_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_DEFAULT_FROM_ADDRESS=info@americantranslationservice.com
RESEND_DEFAULT_FROM_NAME=AET
EMAIL_ASSET_ORIGIN=https://www.americantranslationservice.com

# 07. Payments — configure only the providers/accounts in use
# PAYMENT_SITE_URL is the public payment return origin; local values may use localhost.
# STRIPE_PAYMENT_MODE controls the shared Payment page, not the pre-evaluation test-only client.
# If missing, the shared Payment page defaults to test only in development; otherwise it is disabled.
# PREEVAL_STRIPE_TEST_ENABLED explicitly permits pre-evaluation test calls in cloud-preview.
# Keep test/live keys separate. Original account: California/Miami; BOS: Boston/NYC.
# Hosted Checkout does not read Stripe publishable keys.
# Webhook secrets belong to their exact event destination; do not copy local CLI secrets to Vercel.
PAYMENT_SITE_URL=https://www.americantranslationservice.com
STRIPE_PAYMENT_MODE=test
STRIPE_TEST_SITE_URL=
PREEVAL_STRIPE_TEST_ENABLED=false
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY_BOS=
STRIPE_LIVE_SECRET_KEY_BOS=
PAYPAL_BUSINESS_MIAMI=
PAYPAL_BUSINESS_BOSTON=
PAYPAL_BUSINESS_CALIFORNIA=
PAYPAL_BUSINESS_NYC=

# 08. Optional Dropbox documents and legacy lookup
# DROPBOX_LEGACY_PILOT_ROOT is still required by saved-path resolution for historical pilot files.
# New files use office/application folders; this value is not their new upload root.
# Legacy lookup uses the existing anon key, not service-role credentials.
DROPBOX_DOCUMENTS_ENABLED=false
DROPBOX_LEGACY_PILOT_ROOT="/Team Files/WebsitesDev/AET-PreEvaluation-Test"
AET_APPLICATIONS_SUPABASE_URL=
AET_APPLICATIONS_SUPABASE_ANON_KEY=

# 09. Dropbox original office account — server-only OAuth credentials
DROPBOX_AET_App_KEY=
DROPBOX_AET_App_SECRET=
DROPBOX_AET_App_REFRESH_TOKEN=
DROPBOX_AET_App_NAMESPACE_ID=

# 10. Dropbox East office account — server-only OAuth credentials
DROPBOX_AET_App_East_KEY=
DROPBOX_AET_App_East_SECRET=
DROPBOX_AET_App_East_REFRESH_TOKEN=
DROPBOX_AET_App_East_NAMESPACE_ID=

# 11. Scheduled tasks — independently enabled
# CRON_SECRET authenticates project Cron endpoints.
# PREEVAL_AI_DAILY_RECOVERY_ENABLED is optional (missing means disabled); it does not control on-demand AI.
# Keep STATUS_EXPIRY_ENABLED=false locally. Production uses true and the restricted expiry account.
# Do not replace STATUS_EXPIRY_DATABASE_URL with a CRM/admin connection.
# Scoped email recovery uses separate opt-in settings documented in docs/preeval-email-recovery.md.
# One-off verification flags and staff-session cookies belong on the command line, not in this file.
CRON_SECRET=
PREEVAL_AI_DAILY_RECOVERY_ENABLED=false
STATUS_EXPIRY_ENABLED=false
STATUS_EXPIRY_DATABASE_URL=
