PAYPAL_BUSINESS_MIAMI=
PAYPAL_BUSINESS_BOSTON=
PAYPAL_BUSINESS_CALIFORNIA=
PAYPAL_BUSINESS_NYC=
PAYMENT_SITE_URL=https://www.americantranslationservice.com

# Local frontend pilot. Never use a privileged production business connection.
# Dev 3022 uses cloud-preview; see docs/staff-auth.md for its restricted role.
# Defaults below retain the optional isolated local database mode.
# Vercel dev Preview uses PREEVAL_ENV=preview, PREEVAL_DATABASE_MODE=cloud-preview,
# and PREEVAL_ORIGIN=https://<the exact VERCEL_BRANCH_URL>.
# Enable Vercel system environment variables. Both staff switches must stay false.
# See the Vercel dev Preview section in README.md; never import this whole file.
PREEVAL_ENV=local
PREEVAL_ORIGIN=http://localhost:3021
PREEVAL_DATABASE_MODE=local
PREEVAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
PREEVAL_ADMIN_EMAIL=tech@meiyugroup.org
PREEVAL_TEST_EMAIL=tech@meiyugroup.org
PREEVAL_DROPBOX_ROOT="/Team Files/WebsitesDev/AET-PreEvaluation-Test"
# Direct PDF/image analysis. Server-only; Next.js triggers eligible jobs automatically.
PREEVAL_AI_ENABLED=false
OPENAI_API_KEY=
PREEVAL_OPENAI_MODEL=gpt-6.1-sol
# Optional once-daily Vercel fallback. Keep off until the deployment target is verified.
PREEVAL_AI_DAILY_RECOVERY_ENABLED=false
CRON_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_DEFAULT_FROM_ADDRESS=info@americantranslationservice.com
RESEND_DEFAULT_FROM_NAME=AET
# Public HTTPS asset host for emails, independent of the local application URL.
EMAIL_ASSET_ORIGIN=https://www.americantranslationservice.com
DROPBOX_AET_App_REFRESH_TOKEN=
DROPBOX_AET_App_KEY=
DROPBOX_AET_App_SECRET=
DROPBOX_AET_App_NAMESPACE_ID=

# Staff Auth connects directly to the existing cloud Supabase project.
# Auth and business use separate connections even when they share the cloud project.
# All values below are server-only; see docs/staff-auth.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STAFF_AUTH_DATABASE_URL=
STAFF_LEGACY_MIGRATION_ENABLED=false
STAFF_AUTH_CUTOVER_ENABLED=false

# CRM only: live reads/writes shared records on 3022 or the approved dev Preview.
# Customer forms retain their existing isolated business configuration.
CRM_DATA_SOURCE=preview
CRM_DATABASE_URL=

# Stripe is enabled only for the explicitly selected mode and configured offices.
# Use test locally/in previews; set live only in the customer-facing deployment.
# Production defaults to disabled if this variable is absent or invalid.
STRIPE_PAYMENT_MODE=test

# Original Stripe account: California and Miami. Never falls back to Boston.
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
# Boston Stripe account: Boston and NYC. No fallback to the original account.
STRIPE_TEST_SECRET_KEY_BOS=
# Live keys (rk_live_/sk_live_) are used only when STRIPE_PAYMENT_MODE=live.
STRIPE_LIVE_SECRET_KEY_BOS=
# Publishable keys are optional for hosted Checkout and currently unused.
STRIPE_TEST_PUBLISHABLE_KEY_BOS=
STRIPE_LIVE_PUBLISHABLE_KEY_BOS=
# Test-only origin override; live mode always requires an HTTPS PAYMENT_SITE_URL.
# Local test development returns to localhost automatically;
# deployed test environments otherwise use PAYMENT_SITE_URL.
STRIPE_TEST_SITE_URL=


# Legacy Dropbox document integration (server only).
# Reuse the existing aet-app Dropbox credentials; no new Dropbox app is needed.
# Keep disabled until both office accounts and the legacy lookup are configured.
DROPBOX_DOCUMENTS_ENABLED=false
DROPBOX_AET_App_East_KEY=
DROPBOX_AET_App_East_SECRET=
DROPBOX_AET_App_East_REFRESH_TOKEN=
DROPBOX_AET_App_East_NAMESPACE_ID=
# Existing application database, read-only lookup with the existing anon key.
# Do not use a service-role key or NEXT_PUBLIC_ names here.
AET_APPLICATIONS_SUPABASE_URL=
AET_APPLICATIONS_SUPABASE_ANON_KEY=
