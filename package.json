{
  "name": "aet-website-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3021",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preeval:worker": "node --env-file=.env.local --import ./scripts/register-server-only.mjs --import tsx scripts/preeval/worker.ts",
    "legacy:setup": "node --env-file=.env.local --import tsx scripts/legacy/setup-local.ts",
    "test:legacy": "vitest run tests/legacy-application.test.ts",
    "test:legacy:integration": "node --env-file=.env.local --import tsx scripts/legacy/integration.ts",
    "test:preeval": "vitest run tests/preeval.test.ts",
    "test:evaluation": "vitest run tests/evaluation-application.test.ts tests/evaluation-workflow.test.ts",
    "test:evaluation:workflow": "node --env-file=.env.local --import tsx scripts/evaluation/workflow-integration.ts",
    "test:evaluation:integration": "node --env-file=.env.local --import tsx scripts/evaluation/integration.ts",
    "test:preeval:integration": "node --env-file=.env.local --import tsx scripts/preeval/integration.ts",
    "test:email:records": "node --env-file=.env.local --import ./scripts/register-server-only.mjs --import tsx scripts/email/verify-records.mts",
    "test:intake:integration": "node --env-file=.env.local --import ./scripts/register-server-only.mjs --import tsx scripts/application/intake-integration.mts",
    "test:email:formal": "node --env-file=.env.local --import ./scripts/register-server-only.mjs --import tsx scripts/email/verify-formal-records.mts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "6.11.3",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@openai/codex": "^0.160.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.7.1"
}
