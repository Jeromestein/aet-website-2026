      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_delivery_method_check",
      "type": "c",
      "definition": "CHECK ((delivery_method = ANY (ARRAY['no_delivery_needed'::text, 'usps_first_class_domestic'::text, 'usps_first_class_international'::text, 'usps_priority_domestic'::text, 'usps_express_domestic'::text, 'ups_express_domestic'::text, 'usps_express_international'::text, 'fedex_express_international'::text])))"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_email_check",
      "type": "c",
      "definition": "CHECK ((email ~ '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'::text))"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_fax_check",
      "type": "c",
      "definition": "CHECK ((fax ~ '^\\d{3}-\\d{3}-\\d{4}$'::text))"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_payment_status_check",
      "type": "c",
      "definition": "CHECK ((payment_status = ANY (ARRAY['pending'::text, 'paid'::text, 'failed'::text, 'expired'::text, 'refunded'::text])))"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_payment_status_check1",
      "type": "c",
      "definition": "CHECK ((payment_status = ANY (ARRAY['boston'::text, 'new york'::text, 'miami'::text, 'san francisco'::text, 'los angeles'::text, NULL::text])))"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_phone_check",
      "type": "c",
      "definition": "CHECK ((phone ~ '^\\d{3}-\\d{3}-\\d{4}$'::text))"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_pronouns_check",
      "type": "c",
      "definition": "CHECK ((pronouns = ANY (ARRAY['mr'::text, 'ms'::text, 'mx'::text])))"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_purpose_check",
      "type": "c",
      "definition": "CHECK ((purpose = ANY (ARRAY['evaluation-uscis'::text, 'evaluation-immigration'::text, 'evaluation-employment'::text, 'evaluation-education'::text, 'immigration'::text, 'employment'::text, 'education'::text, 'other'::text, 'translation'::text, 'evaluation'::text, 'interpretation'::text, 'visa'::text])))"
    },
    {
      "table_name": "fce_applications",
      "name": "fce_applications_status_check",
      "type": "c",
      "definition": "CHECK ((status = ANY (ARRAY['draft'::text, 'submitted'::text, 'processing'::text, 'completed'::text, 'cancelled'::text])))"
    },
    {
      "table_name": "fce_applications",
