  "constraints": [
    {
      "table_name": "aet_core_applications",
      "name": "aet_core_applications_email_check",
      "type": "c",
      "definition": "CHECK ((email ~ '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'::text))"
    },
    {
      "table_name": "aet_core_applications",
      "name": "aet_core_applications_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "aet_core_applications",
      "name": "aet_core_applications_status_check",
      "type": "c",
      "definition": "CHECK ((status = ANY (ARRAY['draft'::text, 'submitted'::text, 'processing'::text, 'completed'::text, 'cancelled'::text])))"
    },
    {
      "table_name": "aet_core_educations",
      "name": "aet_core_educations_application_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (application_id) REFERENCES aet_core_applications(id) ON DELETE CASCADE"
    },
    {
      "table_name": "aet_core_educations",
      "name": "aet_core_educations_pkey",
      "type": "p",
